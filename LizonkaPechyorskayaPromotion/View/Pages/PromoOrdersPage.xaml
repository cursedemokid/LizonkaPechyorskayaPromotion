<Page x:Class="LizonkaPechyorskayaPromotion.View.Pages.PromoOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LizonkaPechyorskayaPromotion.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="334" d:DesignWidth="800"
      Title="PromoOrdersPage">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <ListBox Name="OrdersLb" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <!-- Горизонтальная ориентация элементов -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!-- Стиль для каждого элемента ListBoxItem -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#1565C0" BorderThickness="1" CornerRadius="5" Background="#2196F3" 
                            Width="200" Height="300">
                        <Grid Margin="5">
                            <!-- Компактная сетка с меньшими промежутками -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Название с враппингом -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="Название: " Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Name}" Foreground="White" 
                                           TextWrapping="Wrap" MaxWidth="130"/>
                            </StackPanel>

                            <!-- Тип -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <TextBlock Text="Тип: " Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ShareType.Name}" Foreground="White" 
                                           TextWrapping="Wrap" MaxWidth="130"/>
                            </StackPanel>

                            <!-- Клиент с враппингом -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                <TextBlock Text="Клиент: " Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding User.FullName}" Foreground="White" 
                                           TextWrapping="Wrap" MaxWidth="130"/>
                            </StackPanel>

                            <!-- Цена -->
                            <StackPanel Grid.Row="6" Orientation="Horizontal">
                                <TextBlock Text="Цена: " Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Price, StringFormat='{}{0:N0}'}" Foreground="White"/>
                                <TextBlock Text=" руб." Foreground="White"/>
                            </StackPanel>

                            <!-- Период -->
                            <StackPanel Grid.Row="8" Orientation="Horizontal">
                                <TextBlock Text="Период: " Foreground="White" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding StartDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                               Foreground="White" FontSize="11"/>
                                    <TextBlock Text="по" Foreground="White" FontSize="11" 
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding EndDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                               Foreground="White" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Количество сотрудников -->
                            <StackPanel Grid.Row="10" Orientation="Horizontal">
                                <TextBlock Text="Сотрудников: " Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding QuantityPromoters}" Foreground="White"/>
                            </StackPanel>

                            <!-- Менеджер -->
                            <StackPanel Grid.Row="12" Orientation="Horizontal">
                                <TextBlock Text="Менеджер ID: " Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding User1.FullName}" Foreground="White"/>
                            </StackPanel>

                            <!-- Статус -->
                            <StackPanel Grid.Row="14" Orientation="Horizontal">
                                <TextBlock Text="Статус: " Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ShareStatus.Name}" Foreground="White" 
                                           TextWrapping="Wrap" MaxWidth="130"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1">
            <Button Name="FeedbackBtn" Content="Откликнуться" Click="FeedbackBtn_Click" FontSize="10"/>
        </StackPanel>
    </Grid>
</Page>