<Page x:Class="LizonkaPechyorskayaPromotion.View.Pages.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LizonkaPechyorskayaPromotion.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="343" d:DesignWidth="800"
      Title="EmployeesPage">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <ListView Name="EmployeesLv">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="ФИО" DisplayMemberBinding="{Binding FullName}"/>
                    <GridViewColumn Header="Должность" DisplayMemberBinding="{Binding Role.Name}"/>
                    <GridViewColumn Header="Паспорт" DisplayMemberBinding="{Binding PassportData}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Column="1">
            <Button Name="AddBtn" Content="Добавить" Click="AddBtn_Click"/>
            <Button Name="ChangeBtn" Content="Изменить" Click="ChangeBtn_Click"/>
            <Button Name="DeleteBtn" Content="Удалить" Click="DeleteBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
