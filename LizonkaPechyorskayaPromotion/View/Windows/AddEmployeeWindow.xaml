<Window x:Class="LizonkaPechyorskayaPromotion.View.Windows.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Добавление сотрудника" SizeToContent="WidthAndHeight">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="ФИО"/>
        <TextBlock Grid.Row="2" Text="Логин"/>
        <TextBlock Grid.Row="4" Text="Пароль"/>
        <TextBlock Grid.Row="6" Text="Роль"/>
        <TextBlock Grid.Row="8" Text="Паспортные данные"/>

        <TextBox Name="FullNameTb" Grid.Column="2" Grid.Row="0" Width="200"/>
        <TextBox Name="LoginTb" Grid.Column="2" Grid.Row="2" Width="200"/>
        <TextBox Name="PasswordTb" Grid.Column="2" Grid.Row="4" Width="200"/>
        <ComboBox Grid.Column="2" Grid.Row="6" Name="RoleCmb" SelectedValuePath="Id" DisplayMemberPath="Name" Width="200"/>
        <TextBox Name="PassportDataTb" Grid.Column="2" Grid.Row="8" Width="200"/>

        <StackPanel Grid.ColumnSpan="3"  Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="AddBtn" Content="Добавить" Width="100" Height="30" Margin="0,0,10,0" Click="AddBtn_Click"/>
            <Button Name="CancelBtn" Content="Отмена" Width="100" Height="30" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>