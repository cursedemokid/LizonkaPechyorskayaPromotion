<Window x:Class="LizonkaPechyorskayaPromotion.View.Windows.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LizonkaPechyorskayaPromotion.View.Windows"
        mc:Ignorable="d"
        Title="AuthorizationWindow" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Логин"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Пароль"/>

        <TextBox Name="LoginTb" Grid.Column="2" Grid.Row="1"/>
        <PasswordBox Name="PasswordPb" Grid.Column="2" Grid.Row="3"/>

        <Button Name="EnterBtn" Grid.ColumnSpan="3" Grid.Row="5" Width="100" Content="Войти" Click="EnterBtn_Click"/>
    </Grid>
</Window>
