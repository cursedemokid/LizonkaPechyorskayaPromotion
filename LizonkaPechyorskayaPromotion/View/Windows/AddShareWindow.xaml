<Window x:Class="LizonkaPechyorskayaPromotion.View.Windows.AddShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LizonkaPechyorskayaPromotion.View.Windows"
        mc:Ignorable="d"
        Title="AddShareWindow" SizeToContent="WidthAndHeight">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Text="Название"/>
        <TextBlock Grid.Row="2" Text="Тип"/>
        <TextBlock Grid.Row="4" Text="Клиент"/>
        <TextBlock Grid.Row="6" Text="Цена"/>
        <TextBlock Grid.Row="8" Text="Начало"/>
        <TextBlock Grid.Row="10" Text="Конец"/>
        <TextBlock Grid.Row="12" Text="Количество сотрудников"/>
        <TextBlock Grid.Row="14" Text="Оплата в час"/>

        <TextBox Name="NameTb" Grid.Column="2" Width="200"/>
        <TextBox Name="PriceTb" Grid.Column="2" Grid.Row="6" Width="200"/>
        <TextBox Name="QuantityPromotersTb" Grid.Column="2" Grid.Row="12" Width="200"/>
        <TextBox Name="HourlyPayUserTb" Grid.Column="2" Grid.Row="14" Width="200"/>

        <ComboBox Grid.Column="2" Grid.Row="2" Name="TypeCmb" SelectedValuePath="Id" DisplayMemberPath="Name"/>
        <ComboBox Grid.Column="2" Grid.Row="4" Name="ClientCmb" SelectedValuePath="Id" DisplayMemberPath="FullName"/>

        <DatePicker Grid.Column="2" Grid.Row="8" Name="StartDateDp"/>
        <DatePicker Grid.Column="2" Grid.Row="10" Name="EndDateDp"/>

        <StackPanel Grid.ColumnSpan="3"  Grid.Row="16" Orientation="Horizontal">
            <Button Name="AddBtn" Content="Добавить" Click="AddBtn_Click"/>
            <Button Name="CancelBtn" Content="Отмена" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
